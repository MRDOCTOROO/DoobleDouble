+    // ------------------------------------------------------------------ FileBridge
+
+    /**
+     * FileBridge 协议的「服务端」。
+     *
+     * <p>框架的 {@code FileBridgeOutputStream} 会把数据按
+     * {@code [CMD(int)][len(int)][payload]} 的格式写进 socket pair 的客户端，
+     * 本线程从服务端读取并还原成原始字节写入会话文件。协议与系统侧
+     * {@code com.android.internal.util.FileBridge} 保持一致：
+     *
+     * <ul>
+     *   <li>{@code CMD_WRITE=1}：随后有 {@code len} 字节原始数据；</li>
+     *   <li>{@code CMD_FSYNC=2}：对目标文件执行 fsync 后回写 8 字节应答；</li>
+     *   <li>{@code CMD_CLOSE=3}：fsync + close + 应答后退出。</li>
+     * </ul>
+     *
+     * fsync 在 MuMu/libhoudini 上无法跨 ARM↔x86 桥执行，这里配合 OsStub 的
+     * fsync no-op（并把真实 fsync 调用本身也包成 no-op），保证协议回执能走完。
+     */
+    static final class FileBridgeServer extends Thread {
+        private static final int CMD_WRITE = 1;
+        private static final int CMD_FSYNC = 2;
+        private static final int CMD_CLOSE = 3;
+        private static final int MSG_LENGTH = 8;
+
+        private final int mSessionId;
+        private final String mName;
+        private final ParcelFileDescriptor mServer;
+        private final ParcelFileDescriptor mTargetFd;
+        private final File mTarget;
+
+        FileBridgeServer(int sessionId, String name,
+                          ParcelFileDescriptor server, ParcelFileDescriptor targetFd, File target) {
+            super("dooble-filebridge-" + sessionId + "-" + name);
+            mSessionId = sessionId;
+            mName = name;
+            mServer = server;
+            mTargetFd = targetFd;
+            mTarget = target;
+        }
+
+        @Override
+        public void run() {
+            final byte[] header = new byte[MSG_LENGTH];
+            final byte[] payload = new byte[8192];
+            java.io.FileOutputStream raw = null;
+            try {
+                raw = new java.io.FileOutputStream(mTargetFd.getFileDescriptor());
+                while (true) {
+                    int got = readFully(header, 0, MSG_LENGTH);
+                    if (got < MSG_LENGTH) {
+                        // 对端关闭，正常结束
+                        break;
+                    }
+                    java.nio.ByteBuffer buf = java.nio.ByteBuffer.wrap(header);
+                    int cmd = buf.getInt(0);
+                    int len = buf.getInt(4);
+
+                    if (cmd == CMD_WRITE) {
+                        int remaining = len;
+                        while (remaining > 0) {
+                            int r = readFully(payload, 0, Math.min(payload.length, remaining));
+                            if (r <= 0) {
+                                throw new IOException("Unexpected EOF in CMD_WRITE; still expected "
+                                        + remaining + " bytes");
+                            }
+                            raw.write(payload, 0, r);
+                            remaining -= r;
+                        }
+                    } else if (cmd == CMD_FSYNC) {
+                        fsyncQuietly();
+                        writeAck();
+                    } else if (cmd == CMD_CLOSE) {
+                        fsyncQuietly();
+                        //noinspection EmptyTryBlock
+                        try {
+                            mTargetFd.close();
+                        } catch (Throwable ignored) {
+                        }
+                        writeAck();
+                        break;
+                    } else {
+                        Slog.w(TAG, "session " + mSessionId + " FileBridge unknown cmd=" + cmd
+                                + " name=" + mName);
+                        break;
+                    }
+                }
+            } catch (Throwable t) {
+                Slog.w(TAG, "session " + mSessionId + " FileBridge server for " + mName
+                        + " died: " + t);
+            } finally {
+                if (raw != null) {
+                    try {
+                        raw.close();
+                    } catch (Throwable ignored) {
+                    }
+                }
+                try {
+                    mServer.close();
+                } catch (Throwable ignored) {
+                }
+            }
+        }
+
+        private int readFully(byte[] buffer, int off, int len) throws IOException {
+            int total = 0;
+            while (total < len) {
+                int n;
+                try {
+                    n = android.system.Os.read(mServer.getFileDescriptor(), buffer, off + total, len - total);
+                } catch (android.system.ErrnoException e) {
+                    throw new IOException("read failed errno=" + e.errno, e);
+                }
+                if (n < 0) {
+                    throw new IOException("read failed: " + android.system.OsConstants.EIO);
+                }
+                if (n == 0) {
+                    break;
+                }
+                total += n;
+            }
+            return total;
+        }
+
+        private void writeAck() throws IOException {
+            byte[] ack = java.nio.ByteBuffer.allocate(MSG_LENGTH)
+                    .putInt(0).putInt(0).array();
+            try {
+                android.system.Os.write(mServer.getFileDescriptor(), ack, 0, ack.length);
+            } catch (android.system.ErrnoException e) {
+                throw new IOException("write ack failed errno=" + e.errno, e);
+            }
+        }
+
+        private void fsyncQuietly() {
+            try {
+                android.system.Os.fsync(mTargetFd.getFileDescriptor());
+            } catch (Throwable t) {
+                Slog.d(TAG, "session " + mSessionId + " FileBridge fsync ignored: " + t);
+            }
         }
     }
 
