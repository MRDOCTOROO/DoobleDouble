+    /**
+     * 通知所有已注册的回调：会话已创建。
+     *
+     * <p>框架的 {@code SessionCallbackDelegate.onSessionCreated(int)} 会反过来调
+     * {@code PackageInstaller.getSessionInfo(sessionId)} 构造用户侧回调参数，
+     * 因此必须先让 {@code SESSIONS} 里能查到该会话（{@link #GetSessionInfo} 钩子
+     * 会命中），本方法必须在 {@code SESSIONS.put(id, state)} 之后调用。
+     */
+    private static void notifySessionCreated(int sessionId) {
+        invokeCallback("onSessionCreated", new Class<?>[]{int.class},
+                new Object[]{sessionId});
+    }
+
+    /**
+     * 通知所有已注册的回调：会话已结束。
+     *
+     * <p>这是商店「安装中 → 已安装/失败」状态机的关键驱动点。系统服务会在
+     * commit 完成后触发同一回调，容器没有系统会话服务，必须由本代理补上。
+     */
+    private static void notifySessionFinished(int sessionId, boolean success) {
+        invokeCallback("onSessionFinished", new Class<?>[]{int.class, boolean.class},
+                new Object[]{sessionId, success});
+    }
+
+    /**
+     * 在 {@code CALLBACKS} 上逐个反射调用指定方法。
+     *
+     * <p>回调对象是框架的 {@code IPackageInstallerCallback} Stub，方法签名在各
+     * Android 版本上稳定（onSessionCreated(int) / onSessionFinished(int, boolean)）。
+     * 因为类是隐藏接口的 Binder 实现，直接用反射找公开方法即可。
+     */
+    private static void invokeCallback(String name, Class<?>[] types, Object[] args) {
+        Object[] snapshot;
+        synchronized (CALLBACKS) {
+            snapshot = CALLBACKS.toArray();
+        }
+        if (snapshot.length == 0) return;
+        for (Object cb : snapshot) {
+            if (cb == null) continue;
+            try {
+                Method m = cb.getClass().getMethod(name, types);
+                m.invoke(cb, args);
+            } catch (Throwable t) {
+                Slog.w(TAG, "callback " + name + " failed: " + t);
+            }
+        }
+    }
+
+    /**
+     * 反射设置 {@code PackageInstaller.SessionInfo} 的私有字段。
+     */
+    private static void setField(Class<?> cls, Object target, String name, Object value) {
+        try {
+            java.lang.reflect.Field f = cls.getDeclaredField(name);
+            f.setAccessible(true);
+            f.set(target, value);
+        } catch (Throwable t) {
+            Slog.w(TAG, "setField " + name + " failed: " + t);
+        }
+    }
+
