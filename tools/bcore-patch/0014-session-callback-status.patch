+                setField(cls, info, "mSealed", committed.get());
+                setField(cls, info, "mMode", PackageInstaller.SessionParams.MODE_FULL_INSTALL);
+                return info;
+            } catch (Throwable t) {
+                Slog.w(TAG, "sessionInfo failed for " + id + ": " + t);
+                return null;
+            }
+        }
