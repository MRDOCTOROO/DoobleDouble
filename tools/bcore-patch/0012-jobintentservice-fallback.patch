+    /**
+     * JobIntentService 回退路径。
+     *
+     * <p>JobIntentService 用 {@link android.app.job.JobServiceEngine} 作为 job 引擎，
+     * 但它的 onBind 返回的 binder 是 @hide 接口 android.app.job.IJobService 的实现——
+     * Android 9+ 的 hidden API 拦截会让反射 getMethod("onStartJob", ...) 直接抛
+     * NoSuchMethodException，所以不能走 binder 反射。
+     *
+     * <p>正确做法：容器把服务实例化、attach、onCreate 之后，直接反射
+     * JobIntentService 的 mJobImpl 字段（androidx.core 的 app 级类，不受 hidden API
+     * 限制）拿到 JobServiceEngine 对象，再调公开类 JobServiceEngine 的公开方法
+     * onStartJob(params)——虚分派会落到 JobServiceEngineImpl.onStartJob，
+     * JobIntentService 从 JobParameters 的 extras 里读出 work intent 并执行，
+     * F-Droid 的下载任务就能跑了。
+     */
+    private boolean startJobServiceCompat(JobParameters params) {
+        JobRecord record = null;
+        try {
+            record = BlackBoxCore.getBJobManager().queryJobRecord(
+                    BlackBoxCore.getAppProcessName(), params.getJobId());
+            if (record == null || record.mServiceInfo == null) {
+                Slog.w(TAG, "JobIntentService fallback: no JobRecord for " + params.getJobId());
+                return false;
+            }
+            Service service = BlackBoxCore.currentActivityThread().createService(
+                    record.mServiceInfo,
+                    BActivityThread.currentActivityThread().getActivityThread());
+            if (service == null) {
+                Slog.w(TAG, "JobIntentService fallback: cannot create " + record.mServiceInfo.name);
+                return false;
+            }
+            // JobIntentService 的 onBind 只有在 mJobImpl 非空时才返回 binder，
+            // 而 binder 是 @hide 接口 IJobService 的实现（Android 9+ hidden API
+            // 拦截会让反射 getMethod("onStartJob", ...) 直接抛 NoSuchMethodException）。
+            // 所以这里不走 binder，而是直接拿 JobIntentService 内部的
+            // JobServiceEngine 对象（androidx.core 的 mJobImpl 字段，app 级类，
+            // 反射不受 hidden API 限制），再调公开类 JobServiceEngine 的
+            // onStartJob(JobParameters)（SDK 公开方法，同样不受 hidden API 拦截）。
+            Object engine = null;
+            try {
+                Class<?> c = service.getClass();
+                java.lang.reflect.Field f = null;
+                while (c != null) {
+                    try {
+                        f = c.getDeclaredField("mJobImpl");
+                        break;
+                    } catch (NoSuchFieldException ignore) {
+                        c = c.getSuperclass();
+                    }
+                }
+                if (f == null) {
+                    Slog.w(TAG, "JobIntentService fallback: no mJobImpl field on " + service.getClass().getName());
+                    return false;
+                }
+                f.setAccessible(true);
+                engine = f.get(service);
+            } catch (Throwable t1) {
+                Slog.w(TAG, "JobIntentService fallback: cannot read mJobImpl from "
+                        + service.getClass().getName(), t1);
+                return false;
+            }
+            if (engine == null) {
+                Slog.w(TAG, "JobIntentService fallback: mJobImpl is null for " + record.mServiceInfo.name);
+                return false;
+            }
+
+            // JobServiceEngine 是公开类，onStartJob 是公开抽象方法。
+            // 反射调用会按虚分派落到 JobServiceEngineImpl.onStartJob。
+            Method onStartJob = Class.forName("android.app.job.JobServiceEngine")
+                    .getMethod("onStartJob", JobParameters.class);
+            Object result = onStartJob.invoke(engine, params);
+            Slog.d(TAG, "JobIntentService fallback: onStartJob(" + params.getJobId() + ") -> " + result);
+            return result instanceof Boolean ? (Boolean) result : false;
+        } catch (Throwable t) {
+            Slog.w(TAG, "JobIntentService fallback failed for job " + params.getJobId()
+                    + (record != null ? " / " + record.mServiceInfo.name : ""), t);
+            return false;
+        }
+    }
+}
