+
+    /**
+     * JobIntentService 回退路径。
+     *
+     * <p>JobIntentService 的 onBind 返回隐藏接口 android.app.job.IJobService 的
+     * binder（JobServiceEngine）。容器把服务实例化、attach、onCreate、onBind 之后，
+     * 用反射拿到 IJobService，再调 onStartJob(params)——JobIntentService 会从
+     * params 的 extras 里取出 work intent 并执行，这样 F-Droid 的下载任务就能跑了。
+     */
+    private boolean startJobServiceCompat(JobParameters params) {
+        JobRecord record = null;
+        try {
+            record = BlackBoxCore.getBJobManager().queryJobRecord(
+                    BlackBoxCore.getAppProcessName(), params.getJobId());
+            if (record == null || record.mServiceInfo == null) {
+                Slog.w(TAG, "JobIntentService fallback: no JobRecord for " + params.getJobId());
+                return false;
+            }
+            Service service = BlackBoxCore.currentActivityThread().createService(
+                    record.mServiceInfo,
+                    BActivityThread.currentActivityThread().getActivityThread());
+            if (service == null) {
+                Slog.w(TAG, "JobIntentService fallback: cannot create " + record.mServiceInfo.name);
+                return false;
+            }
+            IBinder binder = service.onBind(null);
+            if (binder == null) {
+                Slog.w(TAG, "JobIntentService fallback: onBind returned null for " + record.mServiceInfo.name);
+                return false;
+            }
+            Class<?> stubClass = Class.forName("android.app.job.IJobService$Stub");
+            Method asInterface = stubClass.getMethod("asInterface", IBinder.class);
+            Object iJobService = asInterface.invoke(null, binder);
+            Method onStartJob = iJobService.getClass().getMethod("onStartJob", JobParameters.class);
+            Object result = onStartJob.invoke(iJobService, params);
+            return result instanceof Boolean ? (Boolean) result : false;
+        } catch (Throwable t) {
+            Slog.w(TAG, "JobIntentService fallback failed for job " + params.getJobId()
+                    + (record != null ? " / " + record.mServiceInfo.name : ""), t);
+            return false;
+        }
+    }
+}
