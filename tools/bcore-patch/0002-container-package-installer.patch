+    public static class GetPackageInstaller extends MethodHook {
+        @Override
+        protected Object hook(Object who, Method method, Object[] args) throws Throwable {
+            Object base = method.invoke(who, args);
+            if (base == null) return null;
+            return PackageInstallerProxyHolder.get(base);
+        }
+    }
+
+    /**
+     * 每个进程只建一个代理实例。
+     *
+     * 不能每次调用都新建：{@code PackageInstaller} 会在
+     * {@code ApplicationPackageManager} 里被缓存，但同一进程里可能有多个
+     * Context（Activity / Application / Service）各自持有自己的
+     * {@code PackageManager}，共用一份代理能让会话表天然一致。
+     */
+    private static final class PackageInstallerProxyHolder {
+        private static volatile Object sProxy;
+        private static volatile Object sBase;
+
+        static synchronized Object get(Object base) {
+            if (sProxy == null || sBase != base) {
+                PackageInstallerProxy proxy = new PackageInstallerProxy(base);
+                proxy.injectHook();
+                Object p = proxy.getProxy();
+                if (p == null) return base;
+                sBase = base;
+                sProxy = p;
+            }
+            return sProxy;
+        }
     }
 
