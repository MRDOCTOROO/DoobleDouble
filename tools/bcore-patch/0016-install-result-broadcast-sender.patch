                 }
             }
             IInterface invoke = (IInterface) method.invoke(who, args);
diff --git a/Bcore/src/main/java/top/niunaijun/blackbox/proxy/record/ProxyBroadcastRecord.java b/Bcore/src/main/java/top/niunaijun/blackbox/proxy/record/ProxyBroadcastRecord.java
index b857aaa..3b39f8f 100644
--- a/Bcore/src/main/java/top/niunaijun/blackbox/proxy/record/ProxyBroadcastRecord.java
+++ b/Bcore/src/main/java/top/niunaijun/blackbox/proxy/record/ProxyBroadcastRecord.java
@@ -1,6 +1,7 @@
 package top.niunaijun.blackbox.proxy.record;
 
 import android.content.Intent;
+import android.os.Bundle;
 
 
 public class ProxyBroadcastRecord {
@@ -20,6 +21,23 @@ public class ProxyBroadcastRecord {
     public static ProxyBroadcastRecord create(Intent intent) {
         Intent target = intent.getParcelableExtra("_B_|_target_");
         int userId = intent.getIntExtra("_B_|_user_id_", 0);
+        if (target != null) {
+            Bundle extras = intent.getExtras();
+            if (extras != null) {
+                extras.remove("_B_|_target_");
+                extras.remove("_B_|_user_id_");
+                target.putExtras(extras);
+            }
+            if (target.getAction() == null && intent.getAction() != null) {
+                target.setAction(intent.getAction());
+            }
+            if (target.getData() == null && intent.getData() != null) {
+                target.setData(intent.getData());
+            }
+            if (target.getType() == null && intent.getType() != null) {
+                target.setType(intent.getType());
+            }
+        }
         return new ProxyBroadcastRecord(target, userId);
     }
 
