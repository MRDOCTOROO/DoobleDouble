+    /**
+     * [Dooble] 只登记 ProcessRecord 并分配 bpid 槽位,**不 fork、不等待进程起来**。
+     *
+     * 供 BJobManagerService.schedule 使用:虚拟应用在 Binder 调用里请求调度 Job 时,
+     * 原实现走 startProcessLocked 同步 fork —— 调用方(虚拟应用主线程)会被阻塞
+     * 数秒甚至永久( Zygote 往返 + bindApplication),Aurora 首次点安装整个 UI
+     * 冻结的根因。改为:调度期仅登记;真正拉起发生在代理 Job 触发时 —— 宿主
+     * JobScheduler 启动 :pN 进程后,AppJobServiceDispatcher 经 bindApplication
+     * 按需挂载虚拟应用(createJobService 已支持该路径)。
+     *
+     * 注意:若该槽位随后被真实 fork 复用,startProcessLocked 会按 processName
+     * 覆盖记录,JobRecord 以 (processName, jobId) 为键仍可命中;极端情况下滑
+     * 槽位被其他应用占用时,该 Job 在派发期查不到记录会被宿主按退避重试。
+     */
+    public ProcessRecord allocateProcessRecord(String packageName, String processName, int userId) {
+        ApplicationInfo info = BPackageManagerService.get().getApplicationInfo(packageName, 0, userId);
+        if (info == null)
+            return null;
+        int buid = BUserHandle.getUid(userId, BPackageManagerService.get().getAppId(packageName));
+        synchronized (mProcessLock) {
+            Map<String, ProcessRecord> bProcess = mProcessMap.get(buid);
+            if (bProcess != null) {
+                ProcessRecord existing = bProcess.get(processName);
+                if (existing != null && existing.bpid >= 0) {
+                    return existing;
+                }
+            }
+            int bpid = getUsingBPidL();
+            if (bpid == -1) {
+                return null;
+            }
+            ProcessRecord app = new ProcessRecord(info, processName);
+            app.uid = Process.myUid();
+            app.bpid = bpid;
+            app.buid = BPackageManagerService.get().getAppId(packageName);
+            app.userId = userId;
+            if (bProcess == null) {
+                bProcess = new HashMap<>();
+            }
+            bProcess.put(processName, app);
+            synchronized (mProcessMap) {
+                mProcessMap.put(buid, bProcess);
+            }
+            return app;
+        }
+    }
