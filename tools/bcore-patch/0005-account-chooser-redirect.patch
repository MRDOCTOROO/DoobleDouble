+        /** 宿主系统里"账号选择器"的类名特征（AOSP / 厂商 ROM 的 android.accounts 包） */
+        private static final String[] ACCOUNT_CHOOSER_SUFFIXES = {
+                "accounts.ChooseTypeAndAccountActivity",
+                "accounts.ChooseAccountTypeActivity",
+                "accounts.ChooseAccountActivity",
+        };
+
+        /**
+         * 改道目标的标记 extra。
+         *
+         * 用途：改道后的 intent 带上它；下次再进这个钩子时看到标记就直接放行。
+         * 防的是**递归** —— 曾经把目标设成 microG 的
+         * {@code org.microg.tools.AccountPickerActivity}，结果那个 Activity 在
+         * onCreate 里自己也调 {@code AccountManager.newChooseAccountIntent()}，
+         * 于是被改道回它自己，200ms 内无限循环刷屏。
+         */
+        private static final String EXTRA_REDIRECTED = "_dooble_account_redirect_";
+
+        /**
+         * 空间内 microG 提供的账号入口。
+         *
+         * **只放 LoginActivity，不要放 AccountPickerActivity。**
+         * 后者是个"包装层"，它的实现就是转调系统的
+         * {@code ChooseTypeAndAccountActivity} —— 而系统那个正是我们要绕开的，
+         * 于是形成递归。LoginActivity 是真正干活的登录界面（WebView 加载
+         * accounts.google.com），它不会再回头去调账号选择器。
+         */
+        private static final String[] MICROG_ACCOUNT_ENTRY = {
+                "com.google.android.gms", "org.microg.gms.auth.login.LoginActivity",
+        };
+
+        /**
+         * 把宿主系统账号选择器的 intent 改道到空间内 microG 的登录界面。
+         *
+         * ## 为什么按 intent 的 component 判断，而不是按解析结果判断
+         *
+         * 因为**容器根本解析不了它**：宿主系统包（{@code android}）的活动不在容器的
+         * 组件表里，所以 {@code resolveActivity} 返回 null，代码会走到
+         * {@code resolveInfo == null} 的兜底分支，把**原始 intent** 丢给真实系统。
+         * 那个活动于是在宿主进程（{@code android:ui}, uid 1000）里跑起来 ——
+         * 而宿主的 AccountManager 里没有任何 {@code com.google} 的 authenticator
+         * （microG 装在空间里），于是它立刻打印
+         *   "unable to find account type, pretending the request was canceled"
+         * 然后关掉。用户看到的就是「点了没反应」。
+         *
+         * ## 已知限制（不要以为改了这里 Aurora 就能登录）
+         *
+         * 改道让"添加账号"这条路可达了，但 **Aurora Store 自己的 Google 登录仍然
+         * 完成不了**：它读的是 {@code onActivityResult} 里的
+         * {@code KEY_ACCOUNT_NAME}，而 LoginActivity 不会回填那个结果，
+         * Aurora 仍然收到 RESULT_CANCELED。要真正打通，需要往空间里装一个
+         * 我们自己实现的"账号选择器"APK 来满足那个返回契约 —— 属于后续工作。
+         *
+         * @return 改道后的 ResolveInfo；不需要/无法改道时返回 null（保持原样）
+         */
+        private ResolveInfo resolveAccountChooser(Intent intent) {
+            if (intent == null) {
+                return null;
+            }
+            // 环路保护：这条 intent 是我们自己改道出来的，直接放行
+            if (intent.hasExtra(EXTRA_REDIRECTED)) {
+                return null;
+            }
+            ComponentName comp = intent.getComponent();
+            Slog.i(TAG, "account-chooser probe: component=" + comp);
+            if (comp == null) {
+                return null;
+            }
+            // 只认宿主系统包（package = "android"）。别的包一律不动 ——
+            // 猜错会把正常应用自己的账号页面也劫持掉。
+            if (!"android".equals(comp.getPackageName())) {
+                return null;
+            }
+            String name = comp.getClassName() == null ? "" : comp.getClassName();
+            boolean isChooser = false;
+            for (String suffix : ACCOUNT_CHOOSER_SUFFIXES) {
+                if (name.endsWith(suffix)) {
+                    isChooser = true;
+                    break;
+                }
+            }
+            if (!isChooser) {
+                Slog.i(TAG, "account-chooser: name not recognized (" + name + ")");
+                return null;
+            }
+
+            int userId = BActivityThread.getUserId();
+            ComponentName cn = new ComponentName(MICROG_ACCOUNT_ENTRY[0], MICROG_ACCOUNT_ENTRY[1]);
+            try {
+                ActivityInfo target = BlackBoxCore.getBPackageManager()
+                        .getActivityInfo(cn, GET_META_DATA, userId);
+                if (target == null) {
+                    // 空间里没有 microG：保持原样。宁可让用户看到系统那个空页面，
+                    // 也不要凭空造一个不存在的组件名。
+                    Slog.w(TAG, "No in-container account entry for " + name + "; leaving as-is");
+                    return null;
+                }
+                intent.putExtra(EXTRA_REDIRECTED, true);
+                Slog.i(TAG, "Redirect account chooser " + name + " -> " + cn);
+                ResolveInfo out = new ResolveInfo();
+                out.activityInfo = target;
+                return out;
+            } catch (Throwable t) {
+                Slog.w(TAG, "Probe account entry failed: " + cn + " / " + t.getMessage());
+                return null;
+            }
+        }
+
         /**
          * 是不是一条"要去商店"的链接。
          *
