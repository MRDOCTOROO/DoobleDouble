+            if (intent.getComponent() != null) {
+                return false;
+            }
+            if (!Intent.ACTION_VIEW.equals(intent.getAction())) {
+                return false;
+            }
+            Uri data = intent.getData();
+            if (data == null) {
+                return false;
+            }
+
+            String scheme = data.getScheme();
+            if (scheme == null) {
+                return false;
+            }
+            if ("market".equalsIgnoreCase(scheme)) {
+                return true;
+            }
+
+            String host = data.getHost();
+            if (host == null) {
+                return false;
+            }
+            return host.equalsIgnoreCase("play.google.com")
+                    || host.equalsIgnoreCase("market.android.com");
